OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# "openai" or "anthropic"
LLM_PROVIDER=openai

# Model used for summarization (LLM calls)
CHAT_MODEL=gpt-4o-mini

# Model used for embeddings
EMBEDDING_MODEL=text-embedding-3-small

# Where ChromaDB persists its data
CHROMA_PERSIST_DIR=./data/chroma

# Token budget per code chunk (max 512 recommended)
CHUNK_MAX_TOKENS=512

# Overlap between adjacent chunks when splitting oversized nodes
CHUNK_OVERLAP_TOKENS=64

# Max tokens fed into the LLM for summarization prompts
SUMMARY_MAX_TOKENS=4096

LOG_LEVEL=INFO

# GitHub personal access token (for dataset mining)
# Create at: https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=github_pat_...
